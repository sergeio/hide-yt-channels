{
  "manifest_version": 3,
  "name": "Youtube: Hide Channels",
  "version": "1.0.2",
  "description": "Hide unwanted YouTube channels and videos with one click.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Youtube: Hide Channels"
  },
  "icons": {
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hide-yt-channels@y",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
